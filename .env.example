PROJECT_NAME=TechRoom
ENVIRONMENT=development
DEBUG=True

# Databases
DATABASE_URL=sqlite+aiosqlite:///./techroom.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
QDRANT_URL=http://localhost:6333

# Security
SECRET_KEY=dev-secret-key-change-in-production-123456
ALGORITHM=HS256

# Video Provider
VIDEO_PROVIDER=mock
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=

# AI Gateway
LLM_GATEWAY_DEFAULT_MODEL=gemini-1.5-pro
LLM_GATEWAY_FAST_MODEL=gemini-1.5-flash
AI_DAILY_TOKEN_BUDGET_USER=50000
AI_DAILY_COST_CAP_GLOBAL=100.0
